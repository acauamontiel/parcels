msgstr "Nenhum servidor"

#: data/resources/ui/window.blp:39
msgid ""
"Add a qBittorrent server with the WebUI turned on to manage its torrents "
"from here"
msgstr ""
"Adicione um servidor qBittorrent com a WebUI ativada para gerenciar os "
"torrents dele daqui"

#: data/resources/ui/window.blp:42
msgid "_Add Server"
msgstr "_Adicionar servidor"

