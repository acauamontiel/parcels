#: data/br.com.acauamontiel.Parcels.desktop.in.in:3
#: data/br.com.acauamontiel.Parcels.metainfo.xml.in.in:8
msgid "Remote control for qBittorrent"
msgstr "Controle remoto para o qBittorrent"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/br.com.acauamontiel.Parcels.desktop.in.in:9
msgid "torrent;bittorrent;qbittorrent;magnet;download;remote;"
msgstr "torrent;bittorrent;qbittorrent;magnet;download;remoto;baixar;"

#: data/br.com.acauamontiel.Parcels.gschema.xml.in:6
msgid "Window width"
