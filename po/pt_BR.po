msgstr "Endereço"

#: data/resources/ui/server-dialog.blp:47
msgid "Name (Optional)"
msgstr "Nome (opcional)"

#: data/resources/ui/server-dialog.blp:51
msgid "Accept Invalid Certificates"
msgstr "Aceitar certificados inválidos"

#: data/resources/ui/server-dialog.blp:52
msgid ""
"Only for servers with a self-signed certificate. Other devices on the "
"network could impersonate this server."
msgstr ""
"Só para servidores com certificado autoassinado. Outros dispositivos na rede "
"poderiam se passar por este servidor."

#: data/resources/ui/server-dialog.blp:57
msgid "Authentication"
msgstr "Autenticação"

#: data/resources/ui/server-dialog.blp:65
