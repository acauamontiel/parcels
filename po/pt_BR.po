msgstr "Conectando…"

#: data/resources/ui/window.blp:73
msgid "Unable to Connect"
msgstr "Não foi possível conectar"

#: data/resources/ui/window.blp:81
msgid "_Try Again"
msgstr "_Tentar de novo"

#: data/resources/ui/window.blp:93
msgid "_Edit Server"
msgstr "_Editar servidor"

#: data/resources/ui/window.blp:110
msgid "Connected"
msgstr "Conectado"

#: data/resources/ui/window.blp:121
msgid "_Keyboard Shortcuts"
msgstr "_Atalhos de teclado"

#: data/resources/ui/window.blp:126
msgid "_About Parcels"
msgstr "_Sobre o Parcels"

#. Translators: Replace "translator-credits" with your name/username, and optionally an email or URL.
#: src/application.rs:130
msgid "translator-credits"
msgstr "Acauã Montiel"

#. Translators: Label of the keyring item; {} is the server name
#: src/secrets.rs:51
#, rust-format
msgid "Parcels server “{}”"
msgstr "Servidor “{}” do Parcels"

#: src/session.rs:146 src/widgets/server_dialog.rs:145
msgid "Could not read the password from the keyring"
msgstr "Não foi possível ler a senha do chaveiro"

#: src/session.rs:172
msgid "The server address is not valid"
msgstr "O endereço do servidor não é válido"

#: src/session.rs:174
msgid ""
"Could not reach the server. Check the address and your network connection."
msgstr ""
"Não foi possível alcançar o servidor. Verifique o endereço e a sua conexão "
"de rede."

#: src/session.rs:177
msgid ""
"The server certificate is not trusted. If this server uses a self-signed "
"certificate, turn on “Accept Invalid Certificates” in the server settings."
msgstr ""
"O certificado do servidor não é confiável. Se este servidor usa um "
"certificado autoassinado, ative “Aceitar certificados inválidos” nas "
"configurações do servidor."

#: src/session.rs:179
msgid "Invalid username or password"
msgstr "Usuário ou senha inválidos"

#: src/session.rs:181
msgid ""
"This device is temporarily banned by qBittorrent after too many failed login "
"attempts. Try again later."
msgstr ""
"Este dispositivo foi bloqueado temporariamente pelo qBittorrent depois de "
"muitas tentativas de login sem sucesso. Tente de novo mais tarde."

#: src/session.rs:185
msgid "The API key was rejected. API keys require qBittorrent 5.2 or later."
msgstr ""
"A chave de API foi recusada. Chaves de API exigem o qBittorrent 5.2 ou mais "
"recente."

#: src/session.rs:187
msgid "The server requires a username and password"
msgstr "O servidor exige usuário e senha"

#: src/session.rs:189
msgid "No qBittorrent WebUI was found at this address"
msgstr "Nenhuma WebUI do qBittorrent foi encontrada neste endereço"

#. Translators: {found} and {minimum} are version numbers, e.g. 4.6.7 and 5.0.0
#: src/session.rs:192
#, rust-format
msgid ""
"qBittorrent {found} is not supported. Parcels requires version {minimum} or "
"later."
msgstr ""
"O qBittorrent {found} não é compatível. O Parcels exige a versão {minimum} "
"ou mais recente."

#. Translators: {} is an HTTP status, e.g. "502 Bad Gateway"
#: src/session.rs:198
#, rust-format
msgid "The server returned an unexpected error ({})"
msgstr "O servidor retornou um erro inesperado ({})"

#: src/session.rs:201
msgid "The server sent a response Parcels could not understand"
msgstr "O servidor enviou uma resposta que o Parcels não conseguiu entender"

#. Translators: {} is a list of example addresses
#: src/widgets/server_dialog.rs:90
#, rust-format
msgid "For example: {}"
msgstr "Por exemplo: {}"

#: src/widgets/server_dialog.rs:101
msgid "Edit Server"
msgstr "Editar servidor"

#: src/widgets/server_dialog.rs:102
msgid "_Save"
msgstr "_Salvar"

#: src/widgets/server_dialog.rs:107
msgid "Add Server"
msgstr "Adicionar servidor"

#: src/widgets/server_dialog.rs:108
msgid "_Add"
msgstr "_Adicionar"

#: src/widgets/server_dialog.rs:241
msgid "Requires qBittorrent 5.2 or later. Generate a key in the WebUI options."
msgstr ""
"Exige o qBittorrent 5.2 ou mais recente. Gere uma chave nas opções da WebUI."

#. Translators: {} is a version number, e.g. 5.1.2
#: src/widgets/server_dialog.rs:280
#, rust-format
msgid "Connected to qBittorrent {}"
msgstr "Conectado ao qBittorrent {}"

#: src/widgets/server_dialog.rs:316
msgid "Could not save the password in the keyring"
msgstr "Não foi possível salvar a senha no chaveiro"

#. Translators: {} is the server name
#: src/widgets/server_dialog.rs:362
#, rust-format
msgid "Remove “{}”?"
msgstr "Remover “{}”?"

#: src/widgets/server_dialog.rs:364
msgid ""
"Parcels will forget this server and its password. Torrents on the server are "
"not affected."
msgstr ""
"O Parcels vai esquecer este servidor e a senha dele. Os torrents no servidor "
"não são afetados."

#: src/widgets/server_dialog.rs:371
msgid "_Remove"
msgstr "_Remover"

#: src/widgets/window.rs:208
msgid "_Add Server…"
msgstr "_Adicionar servidor…"

#: src/widgets/window.rs:209
msgid "_Edit Server…"
msgstr "_Editar servidor…"

