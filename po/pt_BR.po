msgstr "Senha"

#: data/resources/ui/server-dialog.blp:70
#: data/resources/ui/server-dialog.blp:85
msgid "API Key"
msgstr "Chave de API"

#: data/resources/ui/server-dialog.blp:75
msgid "Username"
msgstr "Usuário"

#: data/resources/ui/server-dialog.blp:93
msgid "_Test Connection"
msgstr "_Testar conexão"

#: data/resources/ui/server-dialog.blp:145
msgid "_Remove Server"
msgstr "_Remover servidor"

#: data/resources/ui/shortcuts-dialog.blp:6
msgid "General"
msgstr "Geral"

#: data/resources/ui/shortcuts-dialog.blp:9
