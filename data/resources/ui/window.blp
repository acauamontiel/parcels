using Gtk 4.0;
using Adw 1;

template $ParcelsWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 294;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Parcels");
      };

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
    }

    content: Adw.StatusPage status_page {
      title: _("Welcome to Parcels");
      description: _("Remote control for qBittorrent");
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Parcels");
      action: "app.about";
    }
  }
}
