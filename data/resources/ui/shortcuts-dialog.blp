using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Torrents");

    Adw.ShortcutsItem {
      title: _("Open Torrent Files");
      action-name: "win.open-torrent";
    }

    Adw.ShortcutsItem {
      title: _("Paste Magnet Links or Torrent Files");
      accelerator: "<Control>v";
    }

    Adw.ShortcutsItem {
      title: _("Search");
      action-name: "win.search";
    }

    Adw.ShortcutsItem {
      title: _("Select All");
      accelerator: "<Control>a";
    }

    Adw.ShortcutsItem {
      title: _("Unselect All");
      accelerator: "<Control><Shift>a";
    }

    Adw.ShortcutsItem {
      title: _("Show Details");
      accelerator: "Return";
    }

    Adw.ShortcutsItem {
      title: _("Delete");
      accelerator: "Delete";
    }

    Adw.ShortcutsItem {
      title: _("Open Context Menu");
      accelerator: "<Shift>F10";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
