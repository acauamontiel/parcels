<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/br/com/acauamontiel/Parcels/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="servers" type="aa{sv}">
      <default>[]</default>
      <summary>Saved servers</summary>
      <description>Each entry has the keys id, name, url, auth-method, username and accept-invalid-certs. Passwords and API keys are kept in the keyring.</description>
    </key>
    <key name="active-server" type="s">
      <default>""</default>
      <summary>Active server</summary>
      <description>The id of the server Parcels connects to.</description>
    </key>
    <key name="refresh-interval" type="u">
      <range min="500" max="60000"/>
      <default>1500</default>
      <summary>Refresh interval</summary>
      <description>How often to fetch updates from the server while the window is visible, in milliseconds. In the background, updates are fetched every 10 seconds.</description>
    </key>
    <key name="run-in-background" type="b">
      <default>true</default>
      <summary>Run in the background</summary>
      <description>Keep checking the server and sending notifications after the window is closed.</description>
    </key>
    <key name="autostart" type="b">
      <default>false</default>
      <summary>Start automatically</summary>
      <description>Start Parcels in the background when you log in.</description>
    </key>
    <key name="notify-completed" type="b">
      <default>true</default>
      <summary>Notify when downloads finish</summary>
    </key>
    <key name="notify-connection" type="b">
      <default>true</default>
      <summary>Notify about connection problems</summary>
      <description>Notify when the server stays unreachable for longer than connection-notify-delay, and when it comes back.</description>
    </key>
    <key name="connection-notify-delay" type="u">
      <range min="10" max="3600"/>
      <default>60</default>
      <summary>Connection notification delay</summary>
      <description>Seconds the server must stay unreachable before a notification is sent.</description>
    </key>
    <key name="sort-by" type="s">
      <choices>
        <choice value="added"/>
        <choice value="name"/>
        <choice value="progress"/>
        <choice value="size"/>
        <choice value="download-speed"/>
        <choice value="upload-speed"/>
        <choice value="eta"/>
        <choice value="ratio"/>
      </choices>
      <default>"added"</default>
      <summary>Sort torrents by</summary>
    </key>
    <key name="sort-descending" type="b">
      <default>true</default>
      <summary>Sort in descending order</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
  </schema>
</schemalist>
